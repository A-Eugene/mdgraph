{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/mdgraph/bin/mdgraph\" hook index" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|apply_patch",
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/mdgraph/bin/mdgraph\" hook guard" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/mdgraph/bin/mdgraph\" hook nudge" }
        ]
      }
    ]
  }
}
