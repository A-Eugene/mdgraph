graph LR
  subgraph vault["&lt;repo&gt;-mdgraph  (orphan branch, sibling worktree)"]
    direction TB
    E1["upload-queue-contention.md<br/><i>description + date</i>"]
    E2["retry-backoff-reverted.md<br/><i>description + date</i>"]
    E3["latency-budget.md<br/><i>description + date</i>"]
